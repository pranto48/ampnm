<?xml version="1.0"?>

<?if $(sys.BUILDARCH)="x86"?>
    <?define Program_Files="ProgramFilesFolder"?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Program_Files="ProgramFiles64Folder"?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

   <Product Id="*" UpgradeCode="84F66C26-8D65-42E1-94CC-B56149216C2E"
            Name="AMPNM Agent"
            Version="1.0.0"
            Manufacturer="IT Support BD"
            Language="1033">

      <Package InstallerVersion="200" Compressed="yes" Comments="Windows Installer Package" InstallScope="perMachine"/>

      <Media Id="1" Cabinet="product.cab" EmbedCab="yes"/>

      <Upgrade Id="84F66C26-8D65-42E1-94CC-B56149216C2E">
         <UpgradeVersion Minimum="1.0.0" OnlyDetect="yes" Property="NEWERVERSIONDETECTED"/>
         <UpgradeVersion Minimum="0.0.0" Maximum="1.0.0" IncludeMinimum="yes" IncludeMaximum="no"
                         Property="OLDERVERSIONBEINGUPGRADED"/>
      </Upgrade>
      <Condition Message="A newer version of this software is already installed.">NOT NEWERVERSIONDETECTED</Condition>

      <Directory Id="TARGETDIR" Name="SourceDir">

         <Directory Id="$(var.Program_Files)">
            <Directory Id="INSTALLDIR" Name="AMPNM Agent">
               
               <Component Id="ApplicationFiles" Guid="41488f3f-174a-4226-9771-e7e7700905a3">
                  
                    <File Id="ApplicationFile0" Source="..\ampnm-agent.exe"/>
                  
               </Component>
               
               
            </Directory>
         </Directory>

         

         
         <Directory Id="ProgramMenuFolder">
            <Directory Id="ProgramMenuSubfolder" Name="AMPNM Agent">
               <Component Id="ApplicationShortcuts" Guid="C7257F26-38AF-4809-B4A4-EC28C545E3B3">
               
                  <Shortcut Id="ApplicationShortcut0"
                        Name="AMPNM Agent Control Panel"
                        Description="Control panel for the AMPNM Telemetry Agent"
                        Target="[INSTALLDIR]\ampnm-agent.exe"
                        WorkingDirectory="INSTALLDIR"
                        
                        >
                        
                        <Icon Id="Icon0" SourceFile="..\..\app.ico" />
                        
                  </Shortcut>
                  <RegistryValue Root="HKCU"
                    Key="Software\IT Support BD\AMPNM Agent"
                    Name="installed0"
                    Type="integer" Value="1" KeyPath="yes"/>
                
                <RemoveFolder Id="ProgramMenuSubfolder" On="uninstall"/>
               </Component>
            </Directory>
         </Directory>
         

      </Directory>

      
      
      <InstallExecuteSequence>
         <RemoveExistingProducts After="InstallValidate"/>
         
         
      </InstallExecuteSequence>

      <Feature Id="DefaultFeature" Level="1">
         
         
         <ComponentRef Id="ApplicationFiles"/>
         
         
         <ComponentRef Id="ApplicationShortcuts"/>
         
         
      </Feature>

      <UI>
         <!-- Define the installer UI -->
         <UIRef Id="WixUI_HK" />
      </UI>

      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

      <!-- this should help to propagate env var changes -->
      <CustomActionRef Id="WixBroadcastEnvironmentChange" />

   </Product>

</Wix>
